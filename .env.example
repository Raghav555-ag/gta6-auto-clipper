# YouTube Data API Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Pipeline Settings
DEFAULT_CLIP_DURATION=45
MAX_CLIPS_PER_VIDEO=5
OUTPUT_DIR=output
